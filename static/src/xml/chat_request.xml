<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="chat_floating_launcher_19.ChatRequestDialog">
        <Dialog title="props.title" size="'lg'">
            <div class="o_chat_request_form">
                <div class="mb-3">
                    <label class="form-label" for="chat_request_title">Title</label>
                    <input id="chat_request_title" class="form-control" type="text" maxlength="255" t-model="state.title" placeholder="Request title" autofocus="autofocus"/>
                </div>
                <div>
                    <label class="form-label" for="chat_request_description">Description</label>
                    <textarea id="chat_request_description" class="form-control" rows="5" t-model="state.description" placeholder="Describe what you are requesting..."/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" type="button" t-att-disabled="!canSubmit" t-on-click="confirm">Send Request</button>
                <button class="btn btn-secondary" type="button" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="chat_floating_launcher_19.ChatRequestDecisionDialog">
        <Dialog title="heading" size="'lg'">
            <div class="o_chat_request_decision_form">
                <p class="text-muted">Enter the reason for this decision, then confirm.</p>
                <textarea class="form-control" rows="5" t-model="state.reason" placeholder="Explain why you are accepting or rejecting this request..." autofocus="autofocus"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn" t-att-class="props.decision === 'approved' ? 'btn-success' : 'btn-danger'" type="button" t-att-disabled="!canSubmit" t-on-click="confirm">Confirm</button>
                <button class="btn btn-secondary" type="button" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
